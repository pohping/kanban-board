{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kanban-board",
  "main": "apps/web/.open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/web/.open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
